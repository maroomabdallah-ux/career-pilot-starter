APP_NAME=CareerPilot AI API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5440/career_pilot
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
FRONTEND_URL=http://localhost:5173
ENABLE_LEGACY_CRUD_ROUTES=false
OPENAI_API_KEY=
MCP_CORE_SERVER_URL=http://localhost:8001/mcp
